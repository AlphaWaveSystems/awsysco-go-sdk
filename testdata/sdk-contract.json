   "note": "message falls back to status text"
  },
  {
   "id": "err_timeout",
   "status": null,
   "body": null,
   "expect_error": "TimeoutError",
   "note": "no response within timeout \u2192 TimeoutError (NetworkError subclass)"
  },
  {
   "id": "err_network",
   "status": null,
   "body": null,
   "expect_error": "NetworkError",
   "note": "connection refused"
  },
  {
   "id": "err_403_feature_disabled",
   "status": 403,
   "body": {
    "error": true,
    "message": "Live Globe feature not enabled",
    "code": "FEATURE_DISABLED"
   },
   "expect_error": "AuthorizationError",
   "note": "recent clicks behind feature flag; not a path error"
